			(justify left bottom)
		)
		(uuid "4e88e44b-f39e-5a61-9745-08b49d30cf0d")
	)
	(text "  JP1.11  D8  / P1.04  ->  SDA      JP2.12  D10 / P0.11  ->  RDY"
		(exclude_from_sim no)
		(at 20.32 139 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "562a8481-86c4-5a3f-b6c4-57f30f59f981")
	)
	(text "JP1 / JP2 reproduce the nice!nano v2 (Pro Micro) footprint one for one."
		(exclude_from_sim no)
		(at 20.32 127 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "5e0fa2e9-2066-5e61-b15f-df9938557be6")
	)
	(text "reverses the conductor order end to end. TPS43 J1 (datasheet rev 1.06, Aug 2025) is"
		(exclude_from_sim no)
		(at 20.32 159 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "6e92f967-c900-55a1-ad26-c8447e0165fc")
	)
	(text "CON1 is wired as the MIRROR of the trackpad's own connector, because the FFC cable"
		(exclude_from_sim no)
		(at 20.32 155 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "8a671e9f-438e-511a-8db3-5613470e8e8c")
	)
	(text "1:RDY 2:NRST 3:GND 4:VDDHI 5:SCL 6:SDA, so CON1 pin N carries TPS43 pin 7-N."
		(exclude_from_sim no)
		(at 20.32 163 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "951a548a-6038-5b80-8f21-e1d753e77623")
	)
	(text "Every pin not listed below is a bare pass-through: plated hole, no copper attached."
		(exclude_from_sim no)
		(at 20.32 131 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "9b871f96-3cc5-5a06-b521-2df4810a253e")
	)
	(text "straight-through cable instead, this board is wrong and must be re-fabbed."
		(exclude_from_sim no)
		(at 20.32 171 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "c26daa7d-4a9e-5b66-8efc-8a012aa7045e")
	)
	(text "tied to GND. B.Cu is a GND plane carrying the VCC, SCL-to-R2 and RST crossings."
		(exclude_from_sim no)
		(at 20.32 183 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "d3d8714f-4db2-52ec-ac53-124a130e3422")
	)
