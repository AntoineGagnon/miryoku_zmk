#include "../miryoku/custom_config.h"
#include "../miryoku/mapping/36/minidox.h"
#include "../miryoku/miryoku.dtsi"

/ {
  combos {
    compatible = "zmk,combos";
    combo_esc_space_f20 {
      timeout-ms = <50>;
      key-positions = <32 33>;
      bindings = <&kp F20>;
    };
    combo_space_tab_f21 {
      timeout-ms = <50>;
      key-positions = <33 34>;
      bindings = <&kp F21>;
    };
  };
};
